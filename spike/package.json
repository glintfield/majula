{
  "name": "majula-spike",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "generate": "buf generate",
    "generate:swift": "buf generate --template buf.gen.swift.yaml",
    "generate:kotlin": "buf generate --template buf.gen.kotlin.yaml",
    "start": "tsx server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc",
    "certs:init": "sh scripts/init-ca.sh",
    "certs:rotate": "sh scripts/rotate-leaf.sh"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-node": "^2.3.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@types/node": "^22.20.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.2"
  }
}
